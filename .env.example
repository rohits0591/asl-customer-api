# Copy this file to .env for local testing (never commit the real .env file).
# In Vercel: Project Settings -> Environment Variables, add the same three + API_KEY.

# From Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Shared secret that Webex Connect / WxCC flow nodes must send as header: x-api-key
API_KEY=choose-a-long-random-string
